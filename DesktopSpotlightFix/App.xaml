<Application x:Class="DesktopSpotlightFix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="App.Canvas" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="App.Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="App.Line" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="App.Ink" Color="#1E293B"/>
        <SolidColorBrush x:Key="App.Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="App.Accent" Color="#1D4E89"/>
    </Application.Resources>
</Application>
